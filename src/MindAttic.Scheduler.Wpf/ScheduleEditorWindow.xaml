<Window x:Class="MindAttic.Scheduler.Wpf.ScheduleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MindAttic.Scheduler.Wpf.Converters"
        Title="Edit schedule" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch" />
    </Window.Resources>
    <StackPanel Margin="16">
        <RadioButton GroupName="Kind" Content="Repeat every"
                     IsChecked="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Every}" />
        <StackPanel Orientation="Horizontal" Margin="24,4,0,8"
                    Visibility="{Binding IsEvery, Converter={StaticResource Visible}}">
            <TextBox Width="60" Text="{Binding EveryValue, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Width="100" Margin="8,0,0,0" ItemsSource="{Binding EveryUnits}" SelectedItem="{Binding EveryUnit}" />
        </StackPanel>

        <RadioButton GroupName="Kind" Content="Daily, at a fixed time (pinned)"
                     IsChecked="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Daily}" />
        <StackPanel Margin="24,4,0,8" Visibility="{Binding IsDaily, Converter={StaticResource Visible}}">
            <TextBox Width="80" HorizontalAlignment="Left" Text="{Binding DailyTime, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Only on:" Margin="0,8,0,4" />
            <WrapPanel>
                <CheckBox Content="Mon" IsChecked="{Binding Mon}" Margin="0,0,10,0" />
                <CheckBox Content="Tue" IsChecked="{Binding Tue}" Margin="0,0,10,0" />
                <CheckBox Content="Wed" IsChecked="{Binding Wed}" Margin="0,0,10,0" />
                <CheckBox Content="Thu" IsChecked="{Binding Thu}" Margin="0,0,10,0" />
                <CheckBox Content="Fri" IsChecked="{Binding Fri}" Margin="0,0,10,0" />
                <CheckBox Content="Sat" IsChecked="{Binding Sat}" Margin="0,0,10,0" />
                <CheckBox Content="Sun" IsChecked="{Binding Sun}" />
            </WrapPanel>
        </StackPanel>

        <RadioButton GroupName="Kind" Content="Overnight (auto-arranged)"
                     IsChecked="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter=Overnight}" />
        <StackPanel Margin="24,4,0,8" Visibility="{Binding IsOvernight, Converter={StaticResource Visible}}">
            <TextBlock Text="Optimize picks the start time between 00:00 and 08:00, heaviest jobs first, never two at once."
                       TextWrapping="Wrap" Opacity="0.7" />
            <TextBlock Text="Only on:" Margin="0,8,0,4" />
            <WrapPanel>
                <CheckBox Content="Mon" IsChecked="{Binding Mon}" Margin="0,0,10,0" />
                <CheckBox Content="Tue" IsChecked="{Binding Tue}" Margin="0,0,10,0" />
                <CheckBox Content="Wed" IsChecked="{Binding Wed}" Margin="0,0,10,0" />
                <CheckBox Content="Thu" IsChecked="{Binding Thu}" Margin="0,0,10,0" />
                <CheckBox Content="Fri" IsChecked="{Binding Fri}" Margin="0,0,10,0" />
                <CheckBox Content="Sat" IsChecked="{Binding Sat}" Margin="0,0,10,0" />
                <CheckBox Content="Sun" IsChecked="{Binding Sun}" />
            </WrapPanel>
        </StackPanel>

        <RadioButton GroupName="Kind" Content="At logon" Margin="0,0,0,12"
                     IsChecked="{Binding Kind, Converter={StaticResource EnumMatch}, ConverterParameter=AtLogon}" />

        <Separator Margin="0,4,0,8" />
        <TextBlock Text="Or paste a cron expression:" Margin="0,0,0,4" />
        <TextBox Text="{Binding CronText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="{Binding CronError}" Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasCronError, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding PreviewHuman}" Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic" />
        <TextBlock Text="{Binding OtherEntriesNote}" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.7"
                   Visibility="{Binding HasOtherEntries, Converter={StaticResource Visible}}" />
        <TextBlock Text="{Binding SaveError}" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding HasSaveError, Converter={StaticResource Visible}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="OK" Width="80" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
