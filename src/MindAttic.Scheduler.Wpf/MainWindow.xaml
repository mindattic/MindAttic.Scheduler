<Window x:Class="MindAttic.Scheduler.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
        Title="MindAttic Scheduler" Height="640" Width="1180">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SourceName, StringFormat='Source: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="(Azure mirror: not yet available)" Opacity="0.6" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding HistoryStatus}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding Error}" Foreground="Red"
                           Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
            </StatusBarItem>
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Separator />
                <ctl:MaButton Content="Optimize…" Command="{Binding OptimizeCommand}" Margin="0,0,4,0"
                              ToolTip="Re-plan the overnight (auto-arranged) jobs, heaviest first, and preview it before applying." />
                <ctl:MaButton Content="Last night" Command="{Binding LastNightCommand}"
                              ToolTip="Each overnight job's planned slot next to what actually ran." />
                <TextBlock Text="Planning the night…" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"
                           Visibility="{Binding IsPlanning, Converter={StaticResource Visible}}" />
            </ToolBar>
        </ToolBarTray>

        <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="320" />
                <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleHuman}" Width="170" />
                <!-- A template column, not DataGridCheckBoxColumn: the grid's IsReadOnly="True" makes
                     every DataGridColumn read-only (a column can't opt back out), and a checkbox
                     column would only commit on leaving the row. This checkbox commits on click. -->
                <DataGridTemplateColumn Header="Enabled" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsNotBusy}" ToolTip="{Binding Error}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="90" />
                <DataGridTextColumn Header="Next run" Binding="{Binding NextRun}" Width="140" />
                <DataGridTextColumn Header="Last run" Binding="{Binding LastRun}" Width="140" />
                <DataGridTextColumn Header="Last result" Binding="{Binding LastResult}" Width="110" />
                <DataGridTextColumn Header="Usual duration" Binding="{Binding UsualDuration}" Width="95" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="130" />
                <DataGridTemplateColumn Header="Schedule" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Edit…" IsEnabled="{Binding CanEditSchedule}"
                                    Command="{Binding DataContext.EditScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Why the last enable/disable didn't take (the toggle snaps back), otherwise blank. -->
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
