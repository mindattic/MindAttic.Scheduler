<Application x:Class="MindAttic.Scheduler.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MindAttic.Components.Wpf.Controls;assembly=MindAttic.Components.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Every control, text style and colour comes from MindAttic.Components.Wpf, the
                 same shared theme MindAttic.Orchestrator's dashboard uses; this app defines no
                 template of its own. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MindAttic.Components.Wpf;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- The one button (MaButton), given the values of the standard Windows button the
                 rest of this app's windows already show, so its buttons all look alike. A
                 property set on a button wins over these. -->
            <Style TargetType="{x:Type ctl:MaButton}">
                <Setter Property="Shape" Value="Rectangle" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Background" Value="#FFDDDDDD" />
                <Setter Property="BorderBrush" Value="#FF707070" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="HoverBackground" Value="#FFBEE6FD" />
                <Setter Property="HoverBorderBrush" Value="#FF3C7FB1" />
                <Setter Property="PressedBackground" Value="#FFC4E5F6" />
                <Setter Property="FocusedBorderBrush" Value="#FF3C7FB1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
