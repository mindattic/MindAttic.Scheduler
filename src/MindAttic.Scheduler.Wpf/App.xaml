<Application x:Class="MindAttic.Scheduler.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Every control, text style and colour comes from MindAttic.Components.Wpf, the
                 same shared theme MindAttic.Orchestrator's dashboard uses; this app defines no
                 style of its own. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MindAttic.Components.Wpf;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
